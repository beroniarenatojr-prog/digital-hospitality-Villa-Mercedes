APP_NAME="Villa Mercedes Digital Hospitality"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Seeded guest reviews and other demonstration copy. Leave unset locally;
# production should keep this false so demo testimonials are not published.
# RESORT_DEMO_CONTENT=false

# Public Messenger contact link. Set to an empty string to hide this option.
RESORT_MESSENGER_URL=https://m.me/VillaMercedesNatureFarmResort

# Prefer Laragon Apache at this host. php artisan serve is a slower Windows fallback
# (single-threaded, no OPcache). PHP_CLI_SERVER_WORKERS only applies on Unix.
# http://digital-hospitality-villa-mercedes.test
APP_URL=http://digital-hospitality-villa-mercedes.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Intended local and deployment database is MySQL 8.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_hospitality_villa_mercedes
DB_USERNAME=root
DB_PASSWORD=

# Alternative for throwaway local work only:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS only:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# Registration email OTP
OTP_DIGITS=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_EMAIL=5
OTP_MAX_SENDS_PER_IP=10
OTP_MAX_VERIFIES_PER_EMAIL=10
OTP_MAX_VERIFIES_PER_IP=20
OTP_VERIFIED_SESSION_MINUTES=30

RATE_LIMIT_LOGIN=5
# AUTH_REVEAL_PASSWORD_RESET_LINK=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real inbox delivery via Gmail SMTP.
# Create a 16-character App Password: Google Account → Security → 2-Step Verification → App passwords.
# Yahoo alternative: MAIL_HOST=smtp.mail.yahoo.com and a Yahoo app password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME="Villa Mercedes Nature Farm & Resort"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment proof uploads (private disk: storage/app/uploads).
# Values are kilobytes and comma-separated extensions.
UPLOAD_MAX_SIZE=5120
UPLOAD_ALLOWED_MIMES=jpg,jpeg,png,pdf,doc,docx

# New bookings use verified resort QR accounts configured in the admin screen.
# Gateway settings below are retained only for historical reconciliation.
PAYMENT_DEPOSIT_WORKFLOW=true
PAYMENT_GATEWAY=manual
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMENTS_GCASH_NAME="Villa Mercedes Nature Farm & Resort"
PAYMENTS_GCASH_NUMBER=
PAYMENTS_MAYA_NAME="Villa Mercedes Nature Farm & Resort"
PAYMENTS_MAYA_NUMBER=
PAYMENTS_BANK_NAME="Villa Mercedes Nature Farm & Resort"
PAYMENTS_BANK_NUMBER=
PAYMENTS_BANK_LABEL=
